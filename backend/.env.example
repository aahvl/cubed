# Copy this to .env and fill in real values:
#   cp .env.example .env
# .env is gitignored — this file (.env.example) is committed and must
# never contain a real secret, credential, or internal hostname/IP. Every
# value below is either a placeholder, or a dev-only default that matches
# docker-compose.yaml's own hardcoded local Postgres credentials (not a
# real password, and not reachable outside your machine's Docker network).

# --- Database ---
# Matches docker-compose.yaml's postgres service (user/pass/db all "cubed").
# Only change this if you're pointing at a different Postgres instance.
DATABASE_URL=postgres://cubed:cubed@localhost:5432/cubed

# --- Server ---
PORT=8787
# "development" or "production". Controls the `secure` flag on cookies
# (session + OAuth state) — set to "production" only when actually served
# over HTTPS, otherwise the browser will silently drop the cookie.
NODE_ENV=development

# Comma-separated allowlist of origins allowed to call this API — never
# '*'. Must exactly match the frontend's real origin(s), including scheme
# and port, with no trailing slash.
FRONTEND_ORIGINS=http://localhost:4321
# Used to build the URL the OAuth callback and email-adjacent links
# redirect back to (e.g. ".../dashboard" on a successful login).
FRONTEND_URL=http://localhost:4321

# --- Hack Club Auth (create an app: https://auth.hackclub.com/developer/apps/new) ---
# This whole API is mounted under /api (see src/index.ts), so the redirect
# URI you register with Hack Club Auth must include that prefix and match
# HACKCLUB_AUTH_REDIRECT_URI below EXACTLY (scheme/host/port/path) or the
# OAuth exchange will fail.
HACKCLUB_AUTH_CLIENT_ID=
HACKCLUB_AUTH_CLIENT_SECRET=
HACKCLUB_AUTH_REDIRECT_URI=http://localhost:8787/api/auth/callback

# --- Airtable ---
# Personal Access Token: https://airtable.com/create/tokens — needs
# data.records:read, data.records:write, and schema.bases:read scopes,
# with access granted to the one base below. Treat it like a password.
AIRTABLE_PAT=
# The base ID (starts with "app...") — visible in the base's URL, or via
# https://airtable.com/api for that base.
AIRTABLE_BASE_ID=
# Table IDs (start with "tbl...") — open the table, check the URL, or use
# the base's API docs page. One table per purpose:
AIRTABLE_SUBMISSIONS_TABLE_ID=
AIRTABLE_SHOP_ITEMS_TABLE_ID=
AIRTABLE_FULFILLMENT_TABLE_ID=
# The submissions table's attachment field ID (starts with "fld...") that
# the project screenshot gets uploaded into — find it in that base's API
# docs page under the submissions table's fields.
AIRTABLE_SCREENSHOT_FIELD_ID=
# How often (minutes) the backend polls Airtable for review decisions to
# sync back into Postgres. See CLAUDE.md's "Airtable sync" section.
AIRTABLE_SYNC_INTERVAL_MINUTES=15

# --- Slack (optional — only used to fetch a user's profile photo at login) ---
# A Slack app's bot token (starts with "xoxb-") with the `users:read`
# scope: https://api.slack.com/apps. Leave blank to skip avatars — users
# just get an initial-letter avatar instead, nothing breaks.
SLACK_BOT_TOKEN=

# --- Hack Club CDN (optional — for project showcase photos) ---
# Create a key on https://cdn.hackclub.com's API Keys page (docs:
# https://cdn.hackclub.com/docs/api). Leave blank to disable showcase
# photo uploads (that one route 503s; nothing else is affected).
HACKCLUB_CDN_API_KEY=
