---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components'
---

<Layout>
	<main class="relative flex flex-col">
		<div class="absolute z-0 h-screen w-screen bg-sky-400"></div>
		<div class="absolute z-10 h-screen w-screen flex flex-col justify-center items-center">
			<h1 class="font-mono font-bold text-9xl text-white"> 404</h1>
			<div class="flex flex-row justify-center items-center gap-4" >
				<h1 class="font-sans tracking-wide text-white text-2xl font-semibold">Page Not Found</h1>
				<Icon name="sadcry" class="size-8 bg-white"/>
				

			</div>
			<p class="text-white text-xl font-mono ">Sorry, we couldn't find the page you're looking for.</p>
		</div>
	</main>
</Layout>
