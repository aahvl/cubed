---
    import { Image } from "astro:assets";
    import cubed from "../Images/cubed-logo.webp";
    import HeroRsvp from '../components/HeroRsvp.svelte'
---
<div class="h-auto w-screen flex flex-col">

    <!-- Hack club picture -->
     <a href="https://hackclub.com/" class="pointer-events-auto" target="_blank" rel="Link to Hack Club website">
        <div class="absolute top-[-2vh] lg:top-[2vh] md:top-[1vh] sm:top-0 left-0 mt-[2vh]">
            <Image 
                src="https://assets.hackclub.com/flag-orpheus-left.svg" 
                alt="Remote Logo"
                width={300} 
                height={300}
                class="w-[30vw] lg:w-[12.5vw] md:w-[20vw] sm:w-[25vw] h-auto hover:scale-110 hover:mt-2.5 transition-all duration-300 ease-in-out"
                />
        </div>
     </a>

    <!-- The logo + main part of the hero -->
    <div class="h-screen w-full flex flex-col items-center ">
        <div class="mt-[6vh]">

            <!-- text for Hack Club presents -->
            <div class="h-auto w-full items-center flex flex-col justify-center">
                <h3 class="font-anta font-bold text-[4.5vw] lg:text-[3vw] md:text-[5vw] sm:text-[5vw] tracking-wide pointer-events-auto">
                     Hack Club presents...
                </h3>
            </div>
            
            <!-- Big "cubed" title/logo -->
            <div class="mt-[6vh] flex items-center justify-center ">
                <Image 
                    src={cubed} 
                    alt="Project Logo" 
                    class="w-[80vw] lg:w-[42.5vw] md:w-[65vw] sm:w-[75vw] h-auto hover:scale-[1.04] transition-all duration-300 pointer-events-auto"
                    loading="eager" 
                />
            </div>

            <!-- Program description -->
            <div>
                <h4 class="w-fit mx-auto font-anta font-medium text-[5vw] lg:text-[2vw] md:text-[4vw] sm:text-[4vw] tracking-tight mt-[3vh] text-center hover:scale-105 transition-all duration-200 ease-out pointer-events-auto">
                   Ship a science related project, <br> get science related prizes!
                </h4>
            </div>

            <!-- Email and RSVP button -->
            <div class="mt-[3vh] flex flex-col w-screen">
                <!-- This is the Email + Rsvp, take this out when working on the actual site
                <HeroRsvp client:load/>
                 -->
                    <div class="h-auto w-full flex flex-row justify-center gap-4 pointer-events-auto">
                        <button
                        class="bg-white  text-gray-500 outline-4 outline-black/15 max-w-[20vw] px-[1vw] py-[1vh] font-light text-2xl "
                        >
                            Rsvp coming soon...
                        </button>
                    </div>
            </div>
        </div>
    </div>
</div>