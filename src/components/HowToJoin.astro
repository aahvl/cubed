---
const steps = [
  {
    number: "1",
    title: "Sign up",
    description: "Sign up using your email and hackclub account. After signing in you can view the dashboard!",
    hex: "#FFFFFF",
    width: "w-[min(260px,85vw)] md:w-[min(300px,80vw)]",
    py: "py-5",
    align: "self-start",
    margin: "lg:ml-8",
  },
  {
    number: "2",
    title: "Join the Slack",
    description: "Jump into the Hackclub Slack community to ask questions, make friends and talk to other hackclubers",
    hex: "#C0A9F0",
    width: "w-[min(240px,85vw)] md:w-[min(280px,80vw)]",
    py: "py-7",
    align: "self-end",
    margin: "lg:mr-8",
  },
  {
    number: "3",
    title: "Make your project",
    description: "Build your super cool science project, and track your time using hackatime!",
    hex: "#FFE600",
    width: "w-[min(300px,85vw)] md:w-[min(340px,80vw)]",
    py: "py-4",
    align: "self-start",
    margin: "lg:ml-16",
  },
  {
    number: "4",
    title: "Get Prizes",
    description: "Ship and submit your project and awesome prizes will be sent your way!",
    hex: "#86E3CE",
    width: "w-[min(220px,85vw)] md:w-[min(260px,80vw)]",
    py: "py-6",
    align: "self-end",
    margin: "lg:mr-16",
  },
]
---

<section class="relative w-screen min-h-[80vh] bg-[var(--c-bg-2)] overflow-x-clip px-4 md:px-12">
    <div class="max-w-7xl mx-auto h-full flex flex-col lg:flex-row items-center gap-4 lg:gap-10">

        <!-- Title -->
        <div class="lg:w-3/7 flex-shrink-0">
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-anta font-bold text-black leading-tight text-center lg:text-left">
                How can i <span class="whitespace-nowrap">join ?!?!</span>
            </h1>
        </div>

        <!-- Boxes with steps -->
        <div class="lg:w-2/3 lg:min-h-[80vh] relative flex flex-col justify-between gap-8 py-5 md:py-10 lg:gap-0">
            {steps.map((step, i) => (
                <div class={`relative ${step.align} ${step.margin} flex items-center gap-4 md:gap-6`}>
                    {i % 2 === 1 && i < steps.length - 1 && (
                        <svg class="w-16 md:w-24 h-10 md:h-16 text-[var(--c-arrow)] shrink-0 hidden md:block" viewBox="0 0 80 56" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M76 10 C44 10, 32 24, 8 32" />
                            <path d="M18 24 L6 32 L20 40" />
                        </svg>
                    )}

                    <div class={`${step.width} ${step.py} px-2 rounded-lg border-3 border-black`} style={`background-color: ${step.hex}`}>
                        <h3 class="text-xl md:text-2xl font-anta font-bold mb-2 text-black">{step.number}. {step.title}</h3>
                        <p class="text-sm md:text-base text-black">{step.description}</p>
                    </div>

                    {i % 2 === 0 && (
                        <svg class="w-16 md:w-24 h-10 md:h-16 text-[var(--c-arrow)] shrink-0 hidden md:block" viewBox="0 0 80 56" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 10 C36 10, 48 24, 72 32" />
                            <path d="M62 24 L74 32 L60 40" />
                        </svg>
                    )}
                </div>
            ))}
        </div>
    </div>
</section>
<!-- Page breaker -->
<div class="bg-[var(--c-divider-2)] w-screen h-2"></div>