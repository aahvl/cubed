---
    import Layout from '../layouts/Layout.astro';

---

<Layout>
    <main class="relative h-screen overflow-hidden">
        <!--Background -->
        <div class="absolute z-0 h-screen w-screen bg-sky-400"></div>

        <!-- Content -->
        <div class="relative z-10 flex flex-col justify-center items-center h-screen">
            <h1 class="font-mono font-bold text-9xl text-white">Hero Section</h1>
            <p class="text-white text-xl font-mono">This is the hero section of the page.</p>
        </div>
    </main>
</Layout>