---
    import { Image } from "astro:assets";
    import colorfulPB from "../Images/colorfulPB.svg";
    import orphAwe from "../Images/orphAwe.png";
    import prize1 from "../Images/prize1Poster.png";
    import prize2 from "../Images/prize2Rubix.png";
    import prize3 from "../Images/prize3tungtung.png";
    import prize4 from "../Images/prize4calc.png";
    import prize5 from "../Images/prize5tita.png";
    import prize6 from "../Images/prize6sticker.png";
---

<section class="relative flex flex-col bg-[#F9FFFF]">
    <div>
        <Image 
                src={colorfulPB} 
                alt="colorful page breaker"
                width={300} 
                height={300}
                class="w-screen h-auto"
                />
    </div>
    <!--Orph -->
    <div class="absolute top-[15vh] left-[12vw] hover:scale-[1.06] hover:-rotate-9 transition-all duration-300 ">
        <Image 
                src={orphAwe} 
                alt="orphoues in awe"
                width={300} 
                height={300}
                class="w-auto h-15vh"
                />
    </div>

    <!-- Prizes!!  -->

    <div class="absolute top-[55vh] left-[10vw] prize prize1">
        <Image 
                src={prize1} 
                alt="Prize"
                width={420} 
                height={420}
                class="w-auto h-13vh"
                />
    </div>

    <div class="absolute bottom-[9vh] left-[20vw] prize prize2">
        <Image 
                src={prize2} 
                alt="Prize"
                width={300} 
                height={300}
                class="w-auto h-10vh"
                />
    </div>

    <div class="absolute bottom-[6vh] left-[42vw] prize prize3">
        <Image 
                src={prize3} 
                alt="Prize"
                width={300} 
                height={300}
                class="w-auto h-11vh"
                />
    </div>
    <div class="absolute bottom-[12vh] left-[65vw] prize prize4">
        <Image 
                src={prize4} 
                alt="Prize"
                width={300} 
                height={300}
                class="w-auto h-9vh"
                />
    </div>

    <div class="absolute bottom-[14vh] left-[85vw] prize prize5">
        <Image 
                src={prize5} 
                alt="Prize"
                width={300} 
                height={300}
                class="w-auto h-12vh"
                />
    </div>

    <div class="absolute bottom-[35vh] left-[80vw] prize prize6">
        <Image 
                src={prize6} 
                alt="Prize"
                width={300} 
                height={300}
                class="w-auto h-12vh"
                />
    </div>
    
    <!-- Content -->

    <div class="h-[95vh] flex flex-col items-center ">
        <h1 class="text-[7vh] font-anta text-black mt-[7.5vh]  text-center hover:scale-[1.04] transition-all duration-300 ">Wait, what is CUBed???</h1>
        <div class="w-[30vw] h-[35vh] bg-[#92B6EA] shadow-[16px_10px_4px_-1px_rgba(0,0,0,0.5)] shadow-black/30 mt-[7.5vh] flex flex-col items-center justify-center">
            <p class="font-mono text-[2.5vh] text-center font-bold px-[2.5vw] py-[2.5vw] mx-auto my-auto">
                Cubed is a free online summer program for creative teens aged 13–18.
                 Build any science related project you want (calculators, simulations, websites), 
                 log your hours, and earn cool prizes! 
            </p>
        </div>
        <p class="text-gray-700 text-[2vh] text-center mt-auto mb-[2vh]"> 
            Absolutely 0 experience needed. Guides and a community of over 100,000 teens are there to help you get started.
        </p>
    </div>
</section>
        <!-- Page breaker -->
        <div class="bg-[#1A1A1A] w-screen h-2"></div>

<style>
    .prize {
        transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
        cursor: pointer;
    }
    /* prize1: base -rotate-3 → hover +3deg */
    .prize1 { transform: rotate(-3deg); }
    .prize1:hover { transform: scale(1.1) rotate(3deg); }

    /* prize2: base rotate-3 → hover -3deg */
    .prize2 { transform: rotate(3deg); }
    .prize2:hover { transform: scale(1.1) rotate(-3deg); }

    /* prize3: base rotate-1 → hover -1deg */
    .prize3 { transform: rotate(1deg); }
    .prize3:hover { transform: scale(1.1) rotate(-1deg); }

    /* prize4: base -rotate-3 → hover +3deg */
    .prize4 { transform: rotate(-3deg); }
    .prize4:hover { transform: scale(1.1) rotate(3deg); }

    /* prize5: base -rotate-4 → hover +4deg */
    .prize5 { transform: rotate(-4deg); }
    .prize5:hover { transform: scale(1.1) rotate(4deg); }

    /* prize6: base rotate-4 → hover -4deg */
    .prize6 { transform: rotate(4deg); }
    .prize6:hover { transform: scale(1.1) rotate(-4deg); }
</style>
