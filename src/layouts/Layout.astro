---
import "../styles/global.css";

---


<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg" href="/logo.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Anta&display=swap" rel="stylesheet" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Cubed YSWS</title>
		<script is:inline>
			(function () {
				try {
					var stored = localStorage.getItem("cubed-theme");
					var dark = stored
						? stored === "dark"
						: window.matchMedia &&
						  window.matchMedia("(prefers-color-scheme: dark)").matches;
					if (dark) document.documentElement.classList.add("dark");
				} catch (e) {}
			})();
		</script>
	</head>
	<body>
		<slot></slot>

		<!-- Silly little 3D cube toggle — blocky, on-brand, hides when you scroll down -->
		<button
			id="theme-toggle"
			type="button"
			aria-label="Toggle between light and dark mode"
			class="fixed top-3 right-3 z-[60] grid h-12 w-12 place-items-center border-[3px] border-black bg-white text-black shadow-[4px_4px_0_0_rgba(0,0,0,0.9)] transition-all duration-300 ease-out hover:-translate-y-0.5 hover:shadow-[6px_6px_0_0_rgba(0,0,0,0.9)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none"
		>
			<svg
				id="theme-cube"
				viewBox="0 0 24 24"
				class="h-7 w-7 transition-transform duration-300 hover:rotate-3"
				xmlns="http://www.w3.org/2000/svg"
				aria-hidden="true"
			>
				<!-- top face -->
				<polygon
					points="12,3 20,7 12,11 4,7"
					class="fill-[#f5f5f5] dark:fill-[#eef1fa]"
					stroke="currentColor"
					stroke-width="1.6"
					stroke-linejoin="round"
				/>
				<!-- left face -->
				<polygon
					points="4,7 12,11 12,23 4,19"
					class="fill-[#dddddd] dark:fill-[#bcc4dd]"
					stroke="currentColor"
					stroke-width="1.6"
					stroke-linejoin="round"
				/>
				<!-- right face -->
				<polygon
					points="20,7 12,11 12,23 20,19"
					class="fill-[#bfbfbf] dark:fill-[#8ea2d4]"
					stroke="currentColor"
					stroke-width="1.6"
					stroke-linejoin="round"
				/>
			</svg>
		</button>

		<script is:inline>
			(function () {
				var btn = document.getElementById("theme-toggle");
				if (!btn) return;

				btn.addEventListener("click", function () {
					var dark = document.documentElement.classList.toggle("dark");
					try {
						localStorage.setItem("cubed-theme", dark ? "dark" : "light");
					} catch (e) {}
					// give the lil cube a flip
					var ico = document.getElementById("theme-cube");
					if (ico) {
						ico.classList.remove("spin-cube");
						void ico.offsetWidth;
						ico.classList.add("spin-cube");
					}
				});

				// Hide the toggle when scrolling down, bring it back when scrolling up
				var lastY = window.scrollY;
				var queued = false;
				function updateToggle() {
					var y = window.scrollY;
					if (y < 12) {
						btn.classList.remove("toggle-hidden");
					} else if (y > lastY + 6) {
						btn.classList.add("toggle-hidden");
					} else if (y < lastY - 6) {
						btn.classList.remove("toggle-hidden");
					}
					lastY = y;
					queued = false;
				}
				window.addEventListener(
					"scroll",
					function () {
						if (!queued) {
							queued = true;
							requestAnimationFrame(updateToggle);
						}
					},
					{ passive: true }
				);
			})();
		</script>
	</body>
</html>